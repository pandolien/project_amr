# 프로젝트 소스에 C++ 표준 라이브러리 사용이 없는지 검사한다 (cmake -P 로 실행).
# 금지: "std::" 와 C++ 표준 헤더(<vector>, <string>, <cmath> 등). C 헤더(<stdio.h>, <math.h> 등)는 허용.
set(_bad "")
foreach(dir Core main.cpp tests)
    if(IS_DIRECTORY ${SRC}/${dir})
        file(GLOB_RECURSE files ${SRC}/${dir}/*.cpp ${SRC}/${dir}/*.h)
    else()
        set(files ${SRC}/${dir})
    endif()
    foreach(f ${files})
        file(STRINGS ${f} lines)
        set(n 0)
        foreach(line IN LISTS lines)
            math(EXPR n "${n}+1")
            if(line MATCHES "std::" OR line MATCHES "#[ \t]*include[ \t]*<(vector|string|map|set|array|algorithm|memory|sstream|fstream|iostream|locale|functional|utility|cmath|cstdint|cstring|cstdio|cstdlib|cstddef|climits|cfloat|limits|iterator|initializer_list|numeric|unordered_map|unordered_set|list|deque|queue|stack|tuple|type_traits|chrono|thread|mutex|atomic|exception|stdexcept|new|bitset)>")
                list(APPEND _bad "${f}:${n}: ${line}")
            endif()
        endforeach()
    endforeach()
endforeach()
if(_bad)
    string(REPLACE ";" "\n" _msg "${_bad}")
    message(FATAL_ERROR "표준 라이브러리 사용이 남아 있습니다:\n${_msg}")
endif()
message(STATUS "표준 라이브러리 사용 없음")
