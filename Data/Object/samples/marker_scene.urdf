<?xml version="1.0"?>
<!--
  마커 예제: 벽에 붙은 ArUco 마커(4x4 id 20)와 ChArUco 보드(4x4, 5x7)를 센서 카메라로 찍는다.
  마커 메시는 Data/Object/markers 의 것을 쓴다 (simul_main --make-marker 로 만든 것. 흰 판 + 검은 칸 두 메시).
  다른 마커가 필요하면:  simul_main --make-marker aruco,6x6,12,0.2 --marker-dir 폴더
                         simul_main --make-marker charuco,5x5,6,9,0.03,0.022 --marker-dir 폴더
                         (생성된 *_plate.stl / *_ink.stl 을 아래처럼 두 visual 로 넣고 origin 으로 놓는다)

  장면:   벽(x = 1.5) 앞쪽 면에 왼쪽(y = +0.25)에 ArUco 마커(한 변 0.15 m, 흰 여백 포함 0.2 m), 오른쪽(y = -0.25)에 ChArUco 보드.
          카메라는 스탠드(높이 0.92 m)에서 +x 쪽의 벽을 바라본다 (마커 칸이 몇 픽셀은 되어야 읽히므로 1280x960, 가로 시야각 40도). 영상: 센서 +y 가 왼쪽이므로 ArUco 가 영상 왼쪽에 보인다.
  마커 좌표계는 OpenCV 와 같다 (Core/include/CMarker/Marker.h): ArUco 는 원점 중앙, x 오른쪽, y 위, z 보는 쪽 / ChArUco 는 원점 보드 왼쪽 위, x 오른쪽, y 아래, z 보드 안쪽.

  실행:   simul_main Data/Object/samples/marker_scene.urdf --camera-save out/marker
          -> out/marker.png 를 OpenCV 의 cv::aruco::ArucoDetector / CharucoDetector 로 읽으면 마커가 잡힌다.
-->
<robot name="marker_scene">
  <material name="floor"><color rgba="0.62 0.62 0.60 1"/></material>
  <material name="wall"><color rgba="0.55 0.58 0.62 1"/></material>
  <material name="stand"><color rgba="0.25 0.27 0.32 1"/></material>
  <material name="camera"><color rgba="0.10 0.10 0.12 1"/></material>
  <material name="marker_paper"><color rgba="0.93 0.93 0.91 1"/></material>
  <material name="marker_ink"><color rgba="0.03 0.03 0.03 1"/></material>

  <link name="scene">
    <visual>  <!-- 바닥 -->
      <origin xyz="1.0 0 0.01"/>
      <geometry><box size="3.0 3.0 0.02"/></geometry>
      <material name="floor"/>
    </visual>
    <visual>  <!-- 벽 (앞쪽 면이 x = 1.5) -->
      <origin xyz="1.55 0 0.75"/>
      <geometry><box size="0.1 3.0 1.5"/></geometry>
      <material name="wall"/>
    </visual>
    <!-- ArUco 4x4 id 20 (ChArUco 보드의 id 0~16 과 겹치지 않게): 마커 z 가 -x (카메라 쪽), 마커 y 가 위, 마커 x 가 영상 오른쪽(-y) -->
    <visual>
      <origin xyz="1.496 0.25 0.92" rpy="1.5707963 0 -1.5707963"/>
      <geometry><mesh filename="../markers/aruco_4x4_id20_plate.stl"/></geometry>
      <material name="marker_paper"/>
    </visual>
    <visual>
      <origin xyz="1.496 0.25 0.92" rpy="1.5707963 0 -1.5707963"/>
      <geometry><mesh filename="../markers/aruco_4x4_id20_ink.stl"/></geometry>
      <material name="marker_ink"/>
    </visual>
    <!-- ChArUco 4x4 5x7: 보드 원점은 왼쪽 위 모서리. 보드 z 가 +x (벽 쪽), 보드 x 가 -y, 보드 y 가 -z -->
    <visual>
      <origin xyz="1.496 -0.13 1.06" rpy="-1.5707963 0 -1.5707963"/>
      <geometry><mesh filename="../markers/charuco_4x4_5x7_plate.stl"/></geometry>
      <material name="marker_paper"/>
    </visual>
    <visual>
      <origin xyz="1.496 -0.13 1.06" rpy="-1.5707963 0 -1.5707963"/>
      <geometry><mesh filename="../markers/charuco_4x4_5x7_ink.stl"/></geometry>
      <material name="marker_ink"/>
    </visual>
  </link>

  <!-- 카메라 스탠드: 바닥에 고정된 기둥 + 좌우(pan) + 위아래(tilt) -->
  <link name="stand">
    <inertial>
      <origin xyz="0 0 0.4"/>
      <mass value="3.0"/>
      <inertia ixx="0.15" ixy="0" ixz="0" iyy="0.15" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.4"/>
      <geometry><cylinder radius="0.04" length="0.8"/></geometry>
      <material name="stand"/>
    </visual>
  </link>
  <joint name="stand_mount" type="fixed">
    <parent link="scene"/>
    <child link="stand"/>
    <origin xyz="0 0 0.02"/>
  </joint>

  <link name="pan_link">
    <inertial><origin xyz="0 0 0.03"/><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    <visual>
      <origin xyz="0 0 0.03"/>
      <geometry><cylinder radius="0.06" length="0.06"/></geometry>
      <material name="stand"/>
    </visual>
  </link>
  <joint name="pan" type="revolute">
    <parent link="stand"/>
    <child link="pan_link"/>
    <origin xyz="0 0 0.8"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="5" velocity="2"/>
    <dynamics damping="0.5"/>
  </joint>

  <!-- 카메라 본체. 센서 +x 가 앞이고, 이 링크 자신은 영상에 찍히지 않는다 -->
  <link name="cam_link">
    <inertial><origin xyz="0.02 0 0"/><mass value="0.3"/><inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/></inertial>
    <visual>
      <origin xyz="0.02 0 0"/>
      <geometry><box size="0.08 0.12 0.06"/></geometry>
      <material name="camera"/>
    </visual>
    <visual>  <!-- 렌즈 -->
      <origin xyz="0.07 0 0" rpy="0 1.5707963 0"/>
      <geometry><cylinder radius="0.02" length="0.03"/></geometry>
      <material name="stand"/>
    </visual>
  </link>
  <joint name="tilt" type="revolute">
    <parent link="pan_link"/>
    <child link="cam_link"/>
    <origin xyz="0 0 0.1"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.8" upper="0.8" effort="5" velocity="2"/>
    <dynamics damping="0.5"/>
  </joint>

  <!-- 카메라 설정 (Gazebo 형식): 640x480, 가로 시야각 60도(1.0472 rad), 0.05 ~ 6 m. pose 는 cam_link 기준 센서 위치/자세 (x y z roll pitch yaw) -->
  <gazebo reference="cam_link">
    <sensor type="camera" name="camera">
      <pose>0.09 0 0 0 0 0</pose>
      <camera>
        <horizontal_fov>0.7</horizontal_fov>
        <image><width>1280</width><height>960</height></image>
        <clip><near>0.05</near><far>6</far></clip>
      </camera>
    </sensor>
  </gazebo>
</robot>
