<?xml version="1.0"?>
<!-- 회전 낙하 시험 4: 긴 막대(0.8 x 0.08 x 0.08 m)를 비스듬히 놓는다. 한쪽 끝이 먼저 닿아 돌며 쓰러진다.
     뷰어에서 열면 위(z=1.5 m 근처)에서 시작해 중력으로 떨어진다. 기울어진 채 닿으면 모서리로 구르다 한 면에 서서 멈춘다. 단위 m, rad. -->
<robot name="fall_bar">
  <material name="body"><color rgba="0.85 0.75 0.25 1"/></material>
  <link name="fall_bar_link">
    <inertial><origin xyz="0 0 1.5"/><mass value="1.0"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/></inertial>
    <visual>
      <origin xyz="0 0 1.5" rpy="0.3 0.9 0.6"/>
      <geometry><box size="0.8 0.08 0.08"/></geometry>
      <material name="body"/>
    </visual>
  </link>
</robot>
