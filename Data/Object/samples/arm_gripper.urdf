<?xml version="1.0"?>
<!-- 뷰어 확인용 예제: arm.urdf 끝에 fixed 관절(hand)과 mimic 관절(오른쪽 손가락)이 달린 그리퍼를 붙인 것. 질량/관성은 중력 토크 확인용 대략값 -->
<robot name="sample_arm_gripper">
  <material name="gray"><color rgba="0.55 0.57 0.62 1"/></material>
  <material name="orange"><color rgba="0.95 0.5 0.15 1"/></material>
  <material name="blue"><color rgba="0.2 0.45 0.9 1"/></material>
  <material name="green"><color rgba="0.25 0.75 0.4 1"/></material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="5.0"/>
      <inertia ixx="0.1083" ixy="0" ixz="0" iyy="0.1083" iyz="0" izz="0.2083"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.5 0.5 0.1"/></geometry>
      <material name="gray"/>
    </visual>
  </link>

  <link name="shoulder">
    <inertial>
      <origin xyz="0 0 0.15"/>
      <mass value="1.5"/>
      <inertia ixx="0.0127" ixy="0" ixz="0" iyy="0.0127" iyz="0" izz="0.0061"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry><cylinder radius="0.09" length="0.3"/></geometry>
      <material name="orange"/>
    </visual>
  </link>
  <joint name="base_yaw" type="revolute">
    <parent link="base_link"/><child link="shoulder"/>
    <origin xyz="0 0 0.1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="50" velocity="2"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="upper_arm">
    <inertial>
      <origin xyz="0.3 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.037" iyz="0" izz="0.037"/>
    </inertial>
    <visual>
      <origin xyz="0.3 0 0"/>
      <geometry><box size="0.6 0.1 0.1"/></geometry>
      <material name="blue"/>
    </visual>
    <visual>
      <geometry><sphere radius="0.08"/></geometry>
      <material name="gray"/>
    </visual>
  </link>
  <joint name="shoulder_pitch" type="revolute">
    <parent link="shoulder"/><child link="upper_arm"/>
    <origin xyz="0 0 0.3"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="50" velocity="2"/>
  </joint>

  <link name="forearm">
    <inertial>
      <origin xyz="0.25 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.0009" ixy="0" ixz="0" iyy="0.0172" iyz="0" izz="0.0172"/>
    </inertial>
    <visual>
      <origin xyz="0.25 0 0"/>
      <geometry><box size="0.5 0.08 0.08"/></geometry>
      <material name="green"/>
    </visual>
    <visual>
      <geometry><sphere radius="0.065"/></geometry>
      <material name="gray"/>
    </visual>
  </link>
  <joint name="elbow_pitch" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/>
    <origin xyz="0.6 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.4" upper="2.4" effort="30" velocity="2"/>
  </joint>

  <link name="tool">
    <inertial>
      <origin xyz="0.06 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.00014" ixy="0" ixz="0" iyy="0.00039" iyz="0" izz="0.00039"/>
    </inertial>
    <visual>
      <origin xyz="0.06 0 0" rpy="0 1.5707963 0"/>
      <geometry><cylinder radius="0.03" length="0.12"/></geometry>
      <material name="orange"/>
    </visual>
  </link>
  <joint name="wrist_roll" type="continuous">
    <parent link="forearm"/><child link="tool"/>
    <origin xyz="0.5 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>

  <!-- 그리퍼: tool 끝에 fixed 로 손(hand)을 붙이고, 손가락 두 개는 prismatic 이며 오른쪽이 왼쪽을 mimic 한다 -->
  <link name="hand">
    <inertial>
      <origin xyz="0.02 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
    <visual>
      <origin xyz="0.02 0 0"/>
      <geometry><box size="0.04 0.1 0.04"/></geometry>
      <material name="gray"/>
    </visual>
  </link>
  <joint name="tool_mount" type="fixed">
    <parent link="tool"/><child link="hand"/>
    <origin xyz="0.12 0 0"/>
  </joint>

  <link name="finger_left">
    <inertial>
      <origin xyz="0.03 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0.03 0 0"/>
      <geometry><box size="0.06 0.01 0.03"/></geometry>
      <material name="green"/>
    </visual>
  </link>
  <joint name="finger_left_slide" type="prismatic">
    <parent link="hand"/><child link="finger_left"/>
    <origin xyz="0.04 0.04 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.03" effort="10" velocity="0.1"/>
  </joint>

  <link name="finger_right">
    <inertial>
      <origin xyz="0.03 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0.03 0 0"/>
      <geometry><box size="0.06 0.01 0.03"/></geometry>
      <material name="green"/>
    </visual>
  </link>
  <joint name="finger_right_slide" type="prismatic">
    <parent link="hand"/><child link="finger_right"/>
    <origin xyz="0.04 -0.04 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.03" effort="10" velocity="0.1"/>
    <mimic joint="finger_left_slide" multiplier="1" offset="0"/>
  </joint>
</robot>
