<?xml version="1.0"?>
<!--
  2D/3D 라이다 예제: 방 하나와, 그 안을 돌아다니는 라이다 기둥.
  기본 도형만 쓰므로 메시 파일이 필요 없다.

  방:     가로 8 m (x: -4 ~ 4), 세로 6 m (y: -3 ~ 3), 높이 2.5 m. 바닥은 z = 0.
  장애물: 상자(2, 1.2), 원기둥(-2.2, -1.3), 낮은 상자(1.5, -1.5; 높이 0.4 m)
  기둥:   x_slide, y_slide (방 안에서 이동, m), yaw (회전, 도) 관절로 움직인다. 위에 라이다(lidar_link, 높이 1.05 m).
          낮은 상자는 라이다 평면(z = 1.05) 아래라서 수평 2D 스캔에는 잡히지 않는다 (3D 채널을 아래로 향하게 하면 잡힌다).

  실행:   simul_main Data/Object/samples/lidar_room.urdf   (라이다 설정은 아래 <gazebo> 에 있다)
          3D:   아래 vertical 의 samples/min_angle/max_angle 를 고치거나  ... --lidar lidar_link --lidar-channels 16,-15,15
          스캔을 파일로: ... --lidar-csv scan.csv --shot out.png
-->
<robot name="lidar_room">
  <material name="floor"><color rgba="0.62 0.62 0.60 1"/></material>
  <material name="wall"><color rgba="0.85 0.82 0.74 1"/></material>
  <material name="box"><color rgba="0.35 0.55 0.85 1"/></material>
  <material name="column"><color rgba="0.85 0.45 0.35 1"/></material>
  <material name="low"><color rgba="0.40 0.75 0.45 1"/></material>
  <material name="pillar"><color rgba="0.25 0.27 0.32 1"/></material>
  <material name="sensor"><color rgba="0.95 0.75 0.15 1"/></material>

  <!-- 방 (움직이지 않는다). 바닥은 z 0 ~ 0.02 -->
  <link name="room">
    <visual>
      <origin xyz="0 0 0.01"/>
      <geometry><box size="8.4 6.4 0.02"/></geometry>
      <material name="floor"/>
    </visual>
    <visual>  <!-- 북쪽 벽 (y = +3) -->
      <origin xyz="0 3.1 1.25"/>
      <geometry><box size="8.4 0.2 2.5"/></geometry>
      <material name="wall"/>
    </visual>
    <visual>  <!-- 남쪽 벽 (y = -3) -->
      <origin xyz="0 -3.1 1.25"/>
      <geometry><box size="8.4 0.2 2.5"/></geometry>
      <material name="wall"/>
    </visual>
    <visual>  <!-- 동쪽 벽 (x = +4) -->
      <origin xyz="4.1 0 1.25"/>
      <geometry><box size="0.2 6.0 2.5"/></geometry>
      <material name="wall"/>
    </visual>
    <visual>  <!-- 서쪽 벽 (x = -4) -->
      <origin xyz="-4.1 0 1.25"/>
      <geometry><box size="0.2 6.0 2.5"/></geometry>
      <material name="wall"/>
    </visual>
    <visual>  <!-- 상자 장애물 -->
      <origin xyz="2.0 1.2 0.75"/>
      <geometry><box size="1.2 0.8 1.5"/></geometry>
      <material name="box"/>
    </visual>
    <visual>  <!-- 원기둥 장애물 -->
      <origin xyz="-2.2 -1.3 1.25"/>
      <geometry><cylinder radius="0.35" length="2.5"/></geometry>
      <material name="column"/>
    </visual>
    <visual>  <!-- 낮은 상자 (높이 0.4 m): 수평 2D 라이다 평면(1.05 m) 아래 -->
      <origin xyz="1.5 -1.5 0.2"/>
      <geometry><box size="0.8 0.8 0.4"/></geometry>
      <material name="low"/>
    </visual>
      <!-- 충돌 도형: 벽과 장애물만. 바닥(z 0~0.02)은 기둥이 서 있는 땅이라 뺀다 (넣으면 기둥 밑면이 바닥과 겹쳐 처음부터 충돌로 나온다) -->
    <collision><origin xyz="0 3.1 1.25"/><geometry><box size="8.4 0.2 2.5"/></geometry></collision>
    <collision><origin xyz="0 -3.1 1.25"/><geometry><box size="8.4 0.2 2.5"/></geometry></collision>
    <collision><origin xyz="4.1 0 1.25"/><geometry><box size="0.2 6.0 2.5"/></geometry></collision>
    <collision><origin xyz="-4.1 0 1.25"/><geometry><box size="0.2 6.0 2.5"/></geometry></collision>
    <collision><origin xyz="2.0 1.2 0.75"/><geometry><box size="1.2 0.8 1.5"/></geometry></collision>
    <collision><origin xyz="-2.2 -1.3 1.25"/><geometry><cylinder radius="0.35" length="2.5"/></geometry></collision>
    <collision><origin xyz="1.5 -1.5 0.2"/><geometry><box size="0.8 0.8 0.4"/></geometry></collision>
  </link>

  <!-- 방 안에서 기둥을 움직이는 가상 관절 (x, y 이동 + 회전) -->
  <link name="slide_x"/>
  <link name="slide_y"/>

  <joint name="x_slide" type="prismatic">
    <parent link="room"/>
    <child link="slide_x"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.6" upper="3.6" effort="100" velocity="1"/>
    <dynamics damping="5"/>
  </joint>
  <joint name="y_slide" type="prismatic">
    <parent link="slide_x"/>
    <child link="slide_y"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="2.6" effort="100" velocity="1"/>
    <dynamics damping="5"/>
  </joint>

  <link name="pillar">
    <inertial>
      <origin xyz="0 0 0.5"/>
      <mass value="6.0"/>
      <inertia ixx="0.52" ixy="0" ixz="0" iyy="0.52" iyz="0" izz="0.043"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.5"/>
      <geometry><cylinder radius="0.12" length="1.0"/></geometry>
      <material name="pillar"/>
    </visual>
  </link>
  <joint name="yaw" type="continuous">
    <parent link="slide_y"/>
    <child link="pillar"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="1"/>
  </joint>

  <!-- 라이다 (기둥 위). 이 링크 자신은 스캔 대상에서 빠진다. 센서 좌표계: +x 가 앞, +z 가 스캔 평면의 법선 -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0.0"/>
      <geometry><cylinder radius="0.07" length="0.1"/></geometry>
      <material name="sensor"/>
    </visual>
  </link>
  <joint name="lidar_mount" type="fixed">
    <parent link="pillar"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 1.05"/>
  </joint>

  <!-- 라이다 설정 (Gazebo 형식). 왼쪽 구조 트리에서 lidar_link 를 마우스 오른쪽 버튼 -> "레이저 표시" / "그래프 표시" (따로 켜고 끈다)
       270도(-135~135) 를 541 개 광선(0.5도 간격)으로, 수직 채널 1 개 = 2D. 3D 로 바꾸려면 vertical samples 를 늘리고 min/max_angle 을 준다. -->
  <gazebo reference="lidar_link">
    <sensor type="ray" name="lidar">
      <pose>0 0 0 0 0 0</pose>
      <ray>
        <scan>
          <horizontal><samples>541</samples><min_angle>-2.35619449</min_angle><max_angle>2.35619449</max_angle></horizontal>
          <vertical><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
        </scan>
        <range><min>0.05</min><max>30</max></range>
        <noise><type>gaussian</type><mean>0</mean><stddev>0</stddev></noise>
      </ray>
    </sensor>
  </gazebo>
</robot>
